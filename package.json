{
  "author": "@malopestorres",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "format": "prettier . --write --parser typescript \"**/*.[tj]s?(x)\"",
    "lint": "pnpm -w -r run lint",
    "lint:fix": "pnpm -w -r run lint -- --fix",
    "test": "pnpm -w -r run test",
    "start": "pnpm --filter=./packages/slider start",
    "commit": "git-cz",
    "changelog": "standard-changelog",
    "prepare": "husky install",
    "changeset": "changeset",
    "version:changeset": "changeset version",
    "publish:changeset": "changeset publish",
    "contributors:add": "npx all-contributors add",
    "contributors:generate": "npx all-contributors generate"
  },
  "devDependencies": {
    "all-contributors-cli": "^6.17.0",
    "@typescript-eslint/eslint-plugin": "^7.17.0",
    "@typescript-eslint/parser": "^7.17.0",
    "@commitlint/cli": "^17.7.0",
    "@commitlint/config-conventional": "^17.7.0",
    "@rollup/plugin-commonjs": "^24.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@changesets/cli": "^2.27.0",
    "@types/node": "^24.10.1",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.3",
    "prettier": "^3.3.3",
    "standard-changelog": "^6.0.0",
    "typescript": "^5.5.4",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.2",
    "vitest": "^4.1.8"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "tailwindcss": "^4.3.0",
    "vite-plugin-minify": "^1.5.2"
  }
}
