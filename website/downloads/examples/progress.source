<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@sixsrc/brick-slider@1.0.19/lib/brick-slider.css" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Progress Example</title>
    <script src="https://cdn.jsdelivr.net/npm/@sixsrc/brick-slider@1.0.19/lib/brick-slider.browser.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@sixsrc/brick-slider-accessibility@1.0.12/lib/brick-slider-accessibility.browser.js"></script>
  </head>
  <body class="bg-white p-6 font-sans text-gray-950">
    <div class="mx-auto w-full max-w-5xl">
      <div id="slider" class="bs-hidden grid w-full grid-cols-[auto_auto_minmax(0,1fr)_auto] grid-rows-[auto_36px_72px] items-center gap-x-4 max-w-none ">
        <button class="bs-arrow bs-prev z-10 flex h-11 w-11 items-center justify-center rounded-full border border-violet-700 bg-white text-violet-700 hover:bg-violet-50 row-start-3 col-start-1 self-end justify-self-start" type="button"><svg viewBox="0 0 24 24" class="h-6 w-6" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"></path></svg></button>
        <button class="bs-arrow bs-next z-10 flex h-11 w-11 items-center justify-center rounded-full border border-violet-700 bg-white text-violet-700 hover:bg-violet-50 row-start-3 col-start-2 self-end justify-self-start" type="button"><svg viewBox="0 0 24 24" class="h-6 w-6" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"></path></svg></button>
        <div class="bs-pages row-start-3 col-start-4 self-center justify-self-end text-base font-bold text-violet-700"></div>
        <div class="bs-track col-span-full row-start-1 min-w-0 overflow-hidden ">
          <div class="bs-container ">
            <div class="bs-slide">
              <span class="flex h-72 items-center justify-center rounded-3xl border border-violet-700 bg-violet-50 text-violet-700">
                <span class="text-[clamp(4rem,10vw,7rem)] font-bold opacity-90">01</span>
              </span>
            </div>
            <div class="bs-slide">
              <span class="flex h-72 items-center justify-center rounded-3xl border border-violet-700 bg-violet-50 text-violet-700">
                <span class="text-[clamp(4rem,10vw,7rem)] font-bold opacity-90">02</span>
              </span>
            </div>
            <div class="bs-slide">
              <span class="flex h-72 items-center justify-center rounded-3xl border border-violet-700 bg-violet-50 text-violet-700">
                <span class="text-[clamp(4rem,10vw,7rem)] font-bold opacity-90">03</span>
              </span>
            </div>
            <div class="bs-slide">
              <span class="flex h-72 items-center justify-center rounded-3xl border border-violet-700 bg-violet-50 text-violet-700">
                <span class="text-[clamp(4rem,10vw,7rem)] font-bold opacity-90">04</span>
              </span>
            </div>
            <div class="bs-slide">
              <span class="flex h-72 items-center justify-center rounded-3xl border border-violet-700 bg-violet-50 text-violet-700">
                <span class="text-[clamp(4rem,10vw,7rem)] font-bold opacity-90">05</span>
              </span>
            </div>
            <div class="bs-slide">
              <span class="flex h-72 items-center justify-center rounded-3xl border border-violet-700 bg-violet-50 text-violet-700">
                <span class="text-[clamp(4rem,10vw,7rem)] font-bold opacity-90">06</span>
              </span>
            </div>
            <div class="bs-slide">
              <span class="flex h-72 items-center justify-center rounded-3xl border border-violet-700 bg-violet-50 text-violet-700">
                <span class="text-[clamp(4rem,10vw,7rem)] font-bold opacity-90">07</span>
              </span>
            </div>
            <div class="bs-slide">
              <span class="flex h-72 items-center justify-center rounded-3xl border border-violet-700 bg-violet-50 text-violet-700">
                <span class="text-[clamp(4rem,10vw,7rem)] font-bold opacity-90">08</span>
              </span>
            </div>
          </div>
        </div>
        <div class="bs-progress col-span-full row-start-2 h-2 w-full overflow-hidden rounded-full bg-violet-100">
          <span class="bs-progress-bar block h-full bg-violet-700"></span>
        </div>
      </div>
    </div>

    <script type="module">
      
function mountSlider(selector, options) {
  const slider = new window.BrickSlider(selector, options)

  if (window.AccessibilityPlugin) {
    slider.use(
      new window.AccessibilityPlugin({
        useKeyboardNavigation: true
      })
    )
  }

  slider.init()
  return slider
}

      mountSlider("#slider", {
        slidesPerView: 2,
        slidesPerPage: 2,
        gap: 20,
        useLoop: true
      })
    </script>
  </body>
</html>
