{
  "name": "@sixsrc/brick-slider-tailwind",
  "author": "@malopestorres",
  "description": "Tailwind plugin package with BrickSlider structural utilities.",
  "license": "MIT",
  "version": "1.0.8",
  "keywords": [
    "brickslider",
    "brick-slider",
    "tailwindcss",
    "tailwind-plugin",
    "tailwind-preset",
    "slider",
    "carousel",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sixsrc/brickslider.git"
  },
  "homepage": "https://github.com/sixsrc/brickslider#readme",
  "bugs": {
    "url": "https://github.com/sixsrc/brickslider/issues"
  },
  "type": "module",
  "typings": "lib/index.d.ts",
  "files": [
    "lib/brick-slider-tailwind.js",
    "lib/brick-slider.css",
    "lib/preset.css",
    "lib/src/index.d.ts",
    "lib/vite.config.d.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./lib/brick-slider-tailwind.js",
  "module": "./lib/brick-slider-tailwind.js",
  "jsdelivr": "./lib/brick-slider-tailwind.js",
  "exports": {
    ".": {
      "import": "./lib/brick-slider-tailwind.js",
      "default": "./lib/brick-slider-tailwind.js"
    },
    "./preset.css": {
      "default": "./lib/preset.css"
    },
    "./brick-slider.css": {
      "default": "./lib/brick-slider.css"
    }
  },
  "scripts": {
    "build": "tsc --noEmit && vite build && node build.mjs"
  },
  "peerDependencies": {
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "tailwindcss": "^4.3.0"
  }
}
