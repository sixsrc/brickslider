{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "experimentalDecorators": true,
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@sixsrc/brick-slider": ["./src/index.ts"],
      "@sixsrc/brick-slider/plugin-api": ["./src/plugin-api.ts"],
      "@sixsrc/brick-slider-accessibility": ["../accessibility/src/index.ts"],
      "@sixsrc/brick-slider-stories": ["../stories/src/index.ts"],
      "*": ["./*", "./*.mts"]
    },
    "resolveJsonModule": true,
    "allowJs": true,
    "sourceMap": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "exclude": ["lib", "dist", "node_modules"]
}
