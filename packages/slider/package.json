{
  "name": "@sixsrc/brick-slider",
  "author": "@malopestorres",
  "description": "Simple slider plugin, made to be lightweight and practical.",
  "license": "MIT",
  "version": "1.0.18",
  "keywords": [
    "brickslider",
    "brick-slider",
    "slider",
    "carousel",
    "typescript",
    "vanilla-js",
    "web-animation-api",
    "tailwindcss"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sixsrc/brickslider.git"
  },
  "homepage": "https://github.com/sixsrc/brickslider#readme",
  "bugs": {
    "url": "https://github.com/sixsrc/brickslider/issues"
  },
  "type": "module",
  "files": [
    "lib/**/*.js",
    "lib/**/*.css",
    "lib/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./lib/brick-slider.js",
  "module": "./lib/brick-slider.js",
  "jsdelivr": "./lib/brick-slider.browser.js",
  "unpkg": "./lib/brick-slider.browser.js",
  "exports": {
    ".": {
      "types": "./lib/slider/src/index.d.ts",
      "import": "./lib/brick-slider.js",
      "default": "./lib/brick-slider.js"
    },
    "./api": {
      "types": "./lib/slider/src/api.d.ts",
      "import": "./lib/api.js",
      "default": "./lib/api.js"
    },
    "./brick-slider.css": {
      "default": "./lib/brick-slider.css"
    },
    "./browser": {
      "default": "./lib/brick-slider.browser.js"
    }
  },
  "scripts": {
    "start": "vite --host",
    "build": "tsc --noEmit && BUILD_TARGET=lib vite build && BUILD_TARGET=lib vite build --config vite.api.config.ts --emptyOutDir false && BUILD_TARGET=lib vite build --config vite.browser.config.ts --emptyOutDir false && node build.mjs"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "terser": "^5.48.0"
  },
  "types": "lib/slider/src/index.d.ts"
}
