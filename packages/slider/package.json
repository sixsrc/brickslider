{
  "name": "@brickslider/slider",
  "author": "@malopestorres",
  "description": "Simple slider plugin, made to be lightweight and practical and with tailwind classes support.",
  "license": "MIT",
  "version": "0.0.0",
  "keywords": [
    "brickslider",
    "typescript-slider",
    "vanilla-slider",
    "react-slider",
    "solid-slider",
    "carousel-slider",
    "tailwind-slider"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bricksoftware/brick-slider.git"
  },
  "type": "module",
  "typings": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "main": "dist/brick-slider.cjs",
  "module": "./dist/brick-slider.js",
  "exports": {
    ".": {
      "import": "./dist/brick-slider.js",
      "require": "./dist/brick-slider.cjs",
      "default": "./dist/brick-slider.js"
    },
    "./tailwind": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./umd": "./dist/brick-slider.umd.cjs"
  },
  "scripts": {
    "start": "vite --host",
    "test": "vitest",
    "lint": "eslint --ext .ts {src,__tests__}/**.ts",
    "build": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.0.0"
  }
}
