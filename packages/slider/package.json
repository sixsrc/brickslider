{
  "name": "@sixsrc/brickslider",
  "author": "@malopestorres",
  "description": "Simple slider plugin, made to be lightweight and practical.",
  "license": "MIT",
  "version": "0.0.0",
  "keywords": [
    "brickslider",
    "typescript-slider",
    "vanilla-slider",
    "carousel-slider",
    "tailwind-slider"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sixsrc/brickslider.git"
  },
  "type": "module",
  "typings": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/brick-slider.cjs",
  "module": "./dist/brick-slider.js",
  "exports": {
    ".": {
      "import": "./dist/brick-slider.js",
      "require": "./dist/brick-slider.cjs",
      "default": "./dist/brick-slider.js"
    },
    "./umd": "./dist/brick-slider.umd.cjs"
  },
  "scripts": {
    "start": "vite --host",
    "build": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.0"
  }
}
