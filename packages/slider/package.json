{
  "name": "@sixsrc/brick-slider",
  "author": "@malopestorres",
  "description": "Simple slider plugin, made to be lightweight and practical.",
  "license": "MIT",
  "version": "1.0.0",
  "keywords": [
    "brickslider",
    "typescript-slider",
    "vanilla-slider",
    "carousel-slider",
    "tailwind-slider"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sixsrc/brickslider.git"
  },
  "type": "module",
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "unpkg": "./lib/brick-slider.umd.cjs",
  "main": "lib/brick-slider.cjs",
  "module": "./lib/brick-slider.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/brick-slider.js",
      "require": "./lib/brick-slider.cjs",
      "default": "./lib/brick-slider.js"
    },
    "./plugin-api": {
      "types": "./lib/plugin-api.d.ts",
      "import": "./lib/plugin-api.js",
      "require": "./lib/plugin-api.cjs",
      "default": "./lib/plugin-api.js"
    },
    "./umd": "./lib/brick-slider.umd.cjs",
    "./plugin-api/umd": "./lib/plugin-api.umd.cjs"
  },
  "scripts": {
    "start": "vite --host",
    "build": "tsc --noEmit && vite build && vite build --config vite.plugin-api.config.ts && vite build --config vite.cdn.config.ts && vite build --config vite.plugin-api.cdn.config.ts"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.0"
  },
  "types": "lib/index.d.ts"
}
