{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "resolveJsonModule": true,
    "sourceMap": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@sixsrc/brick-slider": ["../slider/src/index.ts"],
      "@sixsrc/brick-slider/plugin-api": ["../slider/src/plugin-api.ts"]
    }
  },
  "exclude": ["lib", "dist", "node_modules"]
}
