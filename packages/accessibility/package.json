{
  "name": "@sixsrc/brick-slider-accessibility",
  "author": "@malopestorres",
  "description": "Accessibility plugin package for BrickSlider.",
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "files": [
    "lib",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "unpkg": "./lib/brick-slider-accessibility.umd.cjs",
  "main": "lib/brick-slider-accessibility.cjs",
  "module": "./lib/brick-slider-accessibility.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/brick-slider-accessibility.js",
      "require": "./lib/brick-slider-accessibility.cjs",
      "default": "./lib/brick-slider-accessibility.js"
    },
    "./umd": "./lib/brick-slider-accessibility.umd.cjs"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build --config vite.cdn.config.ts"
  },
  "peerDependencies": {
    "@sixsrc/brick-slider": "^0.0.0"
  },
  "devDependencies": {
    "@sixsrc/brick-slider": "workspace:*"
  },
  "types": "lib/index.d.ts"
}
