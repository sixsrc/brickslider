{
  "name": "@sixsrc/brick-slider-stories",
  "author": "@malopestorres",
  "description": "Stories plugin package for BrickSlider.",
  "license": "MIT",
  "version": "1.0.14",
  "keywords": [
    "brickslider",
    "brick-slider",
    "stories",
    "instagram-stories",
    "carousel",
    "slider",
    "typescript",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sixsrc/brickslider.git"
  },
  "homepage": "https://github.com/sixsrc/brickslider#readme",
  "bugs": {
    "url": "https://github.com/sixsrc/brickslider/issues"
  },
  "type": "module",
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./lib/brick-slider-stories.js",
  "module": "./lib/brick-slider-stories.js",
  "jsdelivr": "./lib/brick-slider-stories.browser.js",
  "unpkg": "./lib/brick-slider-stories.browser.js",
  "exports": {
    ".": {
      "types": "./lib/stories/src/index.d.ts",
      "import": "./lib/brick-slider-stories.js",
      "default": "./lib/brick-slider-stories.js"
    },
    "./browser": {
      "default": "./lib/brick-slider-stories.browser.js"
    }
  },
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build --config vite.browser.config.ts --emptyOutDir false && node build.mjs"
  },
  "peerDependencies": {
    "@sixsrc/brick-slider": "^1.0.15"
  },
  "devDependencies": {
    "@sixsrc/brick-slider": "workspace:*"
  },
  "types": "lib/stories/src/index.d.ts"
}
