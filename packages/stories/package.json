{
  "name": "@sixsrc/brick-slider-stories",
  "author": "@malopestorres",
  "description": "Stories plugin package for BrickSlider.",
  "license": "MIT",
  "version": "1.0.0",
  "keywords": [
    "brickslider",
    "brick-slider",
    "stories",
    "instagram-stories",
    "carousel",
    "slider",
    "typescript",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sixsrc/brickslider.git"
  },
  "homepage": "https://github.com/sixsrc/brickslider#readme",
  "bugs": {
    "url": "https://github.com/sixsrc/brickslider/issues"
  },
  "type": "module",
  "files": [
    "lib",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "unpkg": "./lib/brick-slider-stories.umd.cjs",
  "main": "lib/brick-slider-stories.cjs",
  "module": "./lib/brick-slider-stories.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/brick-slider-stories.js",
      "require": "./lib/brick-slider-stories.cjs",
      "default": "./lib/brick-slider-stories.js"
    },
    "./umd": "./lib/brick-slider-stories.umd.cjs"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build --config vite.cdn.config.ts"
  },
  "peerDependencies": {
    "@sixsrc/brick-slider": "^1.0.0"
  },
  "devDependencies": {
    "@sixsrc/brick-slider": "workspace:*"
  },
  "types": "lib/index.d.ts"
}
